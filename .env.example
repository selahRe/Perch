# Copy this file to .env and fill your real key.
# One of OPENAI_API_KEY / DEEPSEEK_API_KEY is required.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# OpenAI default:
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible). Any of these work; we normalize to /v1/chat/completions:
# LLM_API_URL=https://api.deepseek.com
# LLM_API_URL=https://api.deepseek.com/v1
# LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat

# Demo mode (for classroom/live demo): disables chat cooldown so repeated triggers can speak with variety.
# PERCH_DEMO_CHAT_MODE=true
